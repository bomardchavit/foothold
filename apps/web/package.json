{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker.ts",
    "db:migrate": "prisma migrate deploy && prisma generate",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "h1b:load": "node --env-file-if-exists=.env --import tsx scripts/load-h1b.ts",
    "ingest": "node --env-file-if-exists=.env --import tsx scripts/ingest.ts",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "prisma": {
    "seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@auth/prisma-adapter": "^2.10.0",
    "@foothold/shared": "*",
    "@prisma/client": "6.19.3",
    "@react-pdf/renderer": "^4.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "date-fns": "^4.1.0",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "lucide-react": "^1.44.0",
    "mammoth": "^1.11.0",
    "next": "15.5.25",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "pg": "^8.16.3",
    "pg-boss": "^12.31.0",
    "playwright": "^1.63.0",
    "posthog-js": "^1.429.5",
    "posthog-node": "^5.52.0",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.3.16",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
