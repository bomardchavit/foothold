# ---- Database (same URL works for `npm run db:local` and docker compose) ----
DATABASE_URL=postgresql://foothold:foothold@localhost:54329/foothold

# ---- Auth (Auth.js v5) ----
AUTH_SECRET=dev-secret-change-me-please
AUTH_URL=http://localhost:3000
# Google sign-in (optional in dev)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Magic-link email via Resend (optional; without it the link is printed to the server console)
AUTH_RESEND_KEY=
EMAIL_FROM=Foothold <login@example.com>
# Password-less dev login button (never enabled in production)
DEV_LOGIN=true

# ---- LLM (Anthropic). auto = anthropic when a key is present, else heuristic ----
LLM_MODE=auto            # auto | anthropic | heuristic | fixture
ANTHROPIC_API_KEY=
LLM_MODEL_MAIN=claude-opus-5
LLM_MODEL_BULK=claude-haiku-4-5

# ---- Embeddings. auto = voyage > openai > local ----
EMBEDDINGS_PROVIDER=auto # auto | voyage | openai | local
VOYAGE_API_KEY=
OPENAI_API_KEY=

# ---- Analytics (optional; no-op when empty) ----
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---- Job sources (Greenhouse/Lever/Ashby need no keys) ----
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# ---- Scraper ----
JOBS_COUNTRIES=US          # comma list of ISO codes to keep (remote/unplaceable jobs always kept); ALL = no filter
SCRAPE_INTERVAL_MIN=10     # scheduler tick: poll every source whose turn has come; 0 disables (the worker schedules instead)
SCRAPE_POLL_MIN=10         # how often an API board is polled (a conditional request, 304 when nothing changed)
SCRAPE_TICK_BUDGET_SEC=420 # a tick stops polling after this long so it never overruns the next one
SCRAPE_CONCURRENCY=4       # sources polled at once (still one request at a time per host)
SCRAPE_HEAVY_PER_TICK=4    # whole-site crawls per tick; API boards are always polled first
SCRAPE_HOUSEKEEPING_MIN=60 # stale flags, out-of-scope pruning, dedupe, logos, industries
SCRAPER_API_DELAY_MS=800   # politeness floor for documented job APIs (SCRAPER_MIN_DELAY_MS applies elsewhere)
SCRAPER_MIN_DELAY_MS=1500  # politeness delay per host
SCRAPER_MAX_PAGES=150      # careers-site crawl page cap
SCRAPER_CONTACT=           # shown in the bot user agent

# ---- Misc ----
APP_URL=http://localhost:3000
STORAGE_DIR=./storage
CRON_SECRET=dev-cron-secret
